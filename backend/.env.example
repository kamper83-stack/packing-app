PORT=5001
JWT_SECRET=super_secret_jwt_token_change_me

# Get a free key at https://www.weatherapi.com/ (sign up -> API key).
# Leaving the placeholder below (or empty) makes the app use mock weather.
WEATHER_API_KEY=your_weather_api_key_here

GEMINI_API_KEY=your_gemini_api_key_here

# Force mock mode for every service regardless of keys. Set to false (or leave
# unset) to use the live APIs whenever a real key is present.
USE_MOCKS=false
