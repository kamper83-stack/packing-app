PORT=5001
JWT_SECRET=super_secret_jwt_token_change_me

# Get a WeatherAPI.com key at https://www.weatherapi.com/ (legacy provider).
# Leaving this placeholder or empty disables the legacy live provider.
WEATHER_API_KEY=your_weather_api_key_here

# Google Weather API key. The backend uses Google automatically when this key
# is real, or explicitly when WEATHER_PROVIDER=google.
GOOGLE_WEATHER_API_KEY=your_google_weather_api_key_here
WEATHER_PROVIDER=google

GEMINI_API_KEY=your_gemini_api_key_here

# Real flight search (Skyscanner Flights on RapidAPI). Sign up at rapidapi.com,
# subscribe to the "Skyscanner Flights API" (host skyscanner-api.p.rapidapi.com),
# and paste your X-RapidAPI-Key here.
# Leaving the placeholder below (or empty) makes the app return sample flights.
RAPIDAPI_KEY=your_rapidapi_key_here

# Force mock mode for every service regardless of keys. Set to false (or leave
# unset) to use the live APIs whenever a real key is present.
USE_MOCKS=false

# Issue #49: email promoted to admin on register/boot. Leave empty for no admin.
ADMIN_EMAIL=
